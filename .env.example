# Copy to .env.local and fill in. Never commit real values.
# Local values come from `npx supabase status`.

# --- Public (bundled into the browser; protected by RLS) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Server only (never prefix with NEXT_PUBLIC_) ---
# Used only by seed/reset scripts, never by the running app or tests (design §1).
SUPABASE_SECRET_KEY=sb_secret_xxx

# AI assistant (Groq, OpenAI-compatible API)
GROQ_API_KEY=gsk_xxx
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MAIN_MODEL=openai/gpt-oss-120b
AI_JUDGE_MODEL=openai/gpt-oss-20b
